PORT=5000
JWT_SECRET=your_jwt_secret_here
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<appName>

# Gmail SMTP Mailer Configuration
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16char_app_password
EMAIL_FROM="Your Business Name" <your_email@gmail.com>
